# Optional: only required when generating answers with a cloud model.
# Shared by Python, LangChain, the UI and AI Hub agents.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b

# Local IRIS instance used by Labs 02 and 03. Jupyter loads this file when its kernel starts.
IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USERNAME=superuser
IRIS_PASSWORD=SYS

# AI Hub image validated by this course edition.
IRIS_IMAGE=docker.iscinternal.com/docker-intersystems/intersystems/iris-community:2027.1.0AI.109.0

# Local-only credentials used by Lab 06. Never reuse them outside this Docker environment.
IRIS_MCP_GATEWAY_USER=CSPSystem
IRIS_MCP_GATEWAY_PASSWORD=SYS
MCP_SUPPORT_USER=mcp-user
MCP_SUPPORT_PASSWORD=test
